---
import type { HTMLAttributes, SvgComponent } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Imported SVG shown in the badge. */
  icon: SvgComponent;
  /** Callout title. */
  heading: string;
  /** Callout text. */
  text: string;
}

const {
  render = true,
  icon,
  heading,
  text,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <div class:list={["callout_wrap", "theme-dark", className]} {...rest}>
      <span class="callout_badge">
        <Icon src={icon} variant="large" />
      </span>
      <div class="callout_content margin-trim">
        <Heading tag="h2" variant="h5">
          {heading}
        </Heading>
        <Paragraph variant="small">{text}</Paragraph>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .callout_wrap {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-5);
      background-color: var(--background);
      color: var(--text);
      border-radius: var(--radius-large);
    }

    .callout_badge {
      flex: none;
      display: grid;
      place-items: center;
      width: var(--hit-target-large);
      aspect-ratio: 1;
      background-color: var(--sun-500);
      color: var(--dark-900);
      border-radius: var(--radius-round);
    }

    .callout_content {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .callout_content .text {
      color: var(--text-2);
    }
  }
</style>
