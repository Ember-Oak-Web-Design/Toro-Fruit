---
import type { HTMLAttributes } from "astro/types";
import { getCollection } from "astro:content";
import Heading from "@/components/typography/Heading.astro";
import FruitRow from "@/components/content/FruitRow.astro";
import { FAMILIES } from "@/data/families.ts";
import {
  MONTH_NAMES,
  MONTH_SHORT,
  byOrder,
  fruitImage,
} from "@/utils/fruit.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

const products = (await getCollection("products")).sort(byOrder);

const groups = FAMILIES.map((family) => ({
  ...family,
  items: products.filter((product) => product.data.family === family.id),
})).filter((group) => group.items.length > 0);
---

{
  render && (
    <div
      class:list={["fruitlist_wrap", className]}
      data-fruit-list
      data-month-names={MONTH_NAMES.join(",")}
      {...rest}
    >
      <div class="fruitlist_filters">
        <div class="fruitlist_filter">
          <span
            class="fruitlist_filter_label text-style-small"
            id="filter-month"
          >
            In season in
          </span>
          <div class="fruitlist_filter_body">
            <div
              class="fruitlist_track"
              role="radiogroup"
              aria-labelledby="filter-month"
            >
              <label class="fruitlist_chip">
                <input type="radio" name="month" value="0" checked />
                <span>All year</span>
              </label>
              {MONTH_SHORT.map((month, index) => (
                <label class="fruitlist_chip">
                  <input type="radio" name="month" value={index + 1} />
                  <span>{month}</span>
                </label>
              ))}
            </div>
            <p
              class="fruitlist_summary text-style-main"
              role="status"
              data-fruit-summary
            >
              Showing the full year
            </p>
          </div>
        </div>
        <div class="fruitlist_filter">
          <span
            class="fruitlist_filter_label text-style-small"
            id="filter-family"
          >
            Family
          </span>
          <div class="fruitlist_filter_body">
            <div
              class="fruitlist_families"
              role="radiogroup"
              aria-labelledby="filter-family"
            >
              <label class="fruitlist_chip outline">
                <input type="radio" name="family" value="all" checked />
                <span>
                  <i class="fruitlist_chip_dot all" aria-hidden="true" />
                  All fruit
                </span>
              </label>
              {groups.map((group) => (
                <label
                  class:list={[
                    "fruitlist_chip",
                    "outline",
                    `family-${group.id}`,
                  ]}
                >
                  <input type="radio" name="family" value={group.id} />
                  <span>
                    <i class="fruitlist_chip_dot" aria-hidden="true" />
                    {group.name}
                  </span>
                </label>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="fruitlist_groups">
        {groups.map((group) => (
          <section
            class:list={["fruitlist_group", `family-${group.id}`]}
            data-fruit-group
            data-family={group.id}
            aria-labelledby={`group-${group.id}`}
          >
            <div class="fruitlist_group_header">
              <div class="fruitlist_group_title">
                <span class="fruitlist_dot" aria-hidden="true" />
                <Heading tag="h3" variant="h4" id={`group-${group.id}`}>
                  {group.name}
                </Heading>
                <span class="fruitlist_count text-style-small">
                  {group.items.length}{" "}
                  {group.id === "veg" ? "vegetables" : "fruits"}
                </span>
              </div>
              <div class="fruitlist_now" aria-hidden="true">
                <span class="fruitlist_now_tag text-style-small" data-now-tag />
              </div>
            </div>
            {group.items.map((product) => (
              <FruitRow
                slug={product.id}
                name={product.data.name}
                family={group.id}
                familyName={group.name}
                image={fruitImage(product.data.image)}
                months={product.data.months}
                description={product.data.description}
              />
            ))}
          </section>
        ))}
      </div>
    </div>
  )
}

<script>
  for (const list of document.querySelectorAll<HTMLElement>(
    "[data-fruit-list]",
  )) {
    const monthNames = (list.dataset.monthNames ?? "").split(",");
    const rows = [...list.querySelectorAll<HTMLElement>("[data-fruit-row]")];
    const groups = [
      ...list.querySelectorAll<HTMLElement>("[data-fruit-group]"),
    ];
    const summary = list.querySelector<HTMLElement>("[data-fruit-summary]");
    const picked = () =>
      Number(
        list.querySelector<HTMLInputElement>('input[name="month"]:checked')
          ?.value ?? 0,
      );
    const family = () =>
      list.querySelector<HTMLInputElement>('input[name="family"]:checked')
        ?.value ?? "all";

    const now = new Date().getMonth() + 1;
    list.style.setProperty("--_now", String(now));
    list.dataset.now = "";
    for (const tag of list.querySelectorAll<HTMLElement>("[data-now-tag]")) {
      tag.textContent = `Now · ${monthNames[now - 1].slice(0, 3)}`;
    }

    const apply = () => {
      const month = picked();
      const chosen = family();
      let inSeason = 0;
      let shown = 0;

      for (const group of groups) {
        group.hidden = chosen !== "all" && group.dataset.family !== chosen;
      }

      for (const row of rows) {
        const months = (row.dataset.months ?? "").split(",").map(Number);
        const available = month === 0 || months.includes(month);
        const status = row.querySelector<HTMLElement>("[data-fruit-status]");
        const season = row.querySelector<HTMLElement>(".fruitrow_season");
        const visible = !row.closest<HTMLElement>("[data-fruit-group]")?.hidden;

        if (visible) {
          shown += 1;
          if (month !== 0 && available) inSeason += 1;
        }

        if (month === 0) {
          delete row.dataset.state;
        } else {
          row.dataset.state = available ? "in" : "out";
        }
        if (status) {
          status.hidden = month === 0;
          status.textContent = available ? "In season" : "Out of season";
        }
        if (season) season.hidden = month !== 0;

        for (const cell of row.querySelectorAll<HTMLElement>(
          ".fruitrow_cell",
        )) {
          if (month !== 0 && Number(cell.dataset.month) === month) {
            cell.dataset.picked = "";
          } else {
            delete cell.dataset.picked;
          }
        }
      }

      if (summary) {
        summary.textContent =
          month === 0
            ? "Showing the full year"
            : `${inSeason} of ${shown} in season in ${monthNames[month - 1]}`;
      }
    };

    list.addEventListener("change", apply);
    apply();

    const openFromHash = () => {
      const target = location.hash
        ? list.querySelector<HTMLDetailsElement>(
            `details${CSS.escape(location.hash)}`,
          )
        : null;
      if (target) {
        target.open = true;
        target.scrollIntoView({ block: "center" });
      }
    };
    openFromHash();
    addEventListener("hashchange", openFromHash);
  }
</script>

<style is:global>
  @layer components {
    .fruitlist_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      width: 100%;
    }

    .fruitlist_filters {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .fruitlist_filter {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .fruitlist_filter_label {
      font-weight: var(--secondary-bold);
      letter-spacing: var(--letter-spacing-eyebrow);
      text-transform: uppercase;
    }

    .fruitlist_filter_body {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-4);
      min-width: 0;
    }

    .fruitlist_track {
      display: flex;
      gap: var(--space-1);
      max-width: 100%;
      padding: var(--space-1);
      overflow-x: auto;
      background-color: var(--light-400);
      border-radius: var(--radius-round);
    }

    .fruitlist_families {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .fruitlist_chip {
      position: relative;
      flex: none;
      display: inline-flex;
      cursor: pointer;

      input {
        position: absolute;
        opacity: 0;
        inset: 0;
        margin: 0;
        cursor: pointer;
      }

      span {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-height: var(--hit-target-min);
        padding-inline: var(--space-3);
        border-radius: var(--radius-round);
        font-size: var(--text-small);
        font-weight: var(--secondary-semibold);
        transition:
          background-color var(--hover-duration) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease);
      }

      &:has(input:checked) span {
        background-color: var(--button-background);
        color: var(--button-text);
      }

      &:has(input:focus-visible) span {
        outline: var(--focus-width) solid var(--text);
        outline-offset: var(--focus-offset);
      }

      &.outline span {
        background-color: var(--light-200);
        box-shadow: inset 0 0 0 var(--border-width) var(--light-600);
      }

      &.outline:has(input:checked) span {
        background-color: var(--button-background);
        box-shadow: inset 0 0 0 var(--border-width) var(--button-border);
      }
    }

    .fruitlist_chip_dot {
      width: var(--space-2);
      aspect-ratio: 1;
      background-color: var(--_family);
      border-radius: var(--radius-round);

      &.all {
        background-color: var(--text-2);
      }
    }

    .fruitlist_summary {
      flex: none;
      color: var(--text-2);
      font-weight: var(--secondary-semibold);
    }

    .fruitlist_groups {
      display: flex;
      flex-direction: column;
    }

    .fruitlist_group[hidden] {
      display: none;
    }

    .fruitlist_group_header {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: end;
      min-height: calc(var(--row-height) - var(--space-2));
      padding-top: var(--space-6);
      padding-bottom: var(--space-3);
      border-bottom: var(--border-width) solid var(--text);
    }

    .fruitlist_group_title {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
    }

    .fruitlist_dot {
      flex: none;
      width: var(--space-3);
      aspect-ratio: 1;
      background-color: var(--_family);
      border-radius: var(--radius-round);
      align-self: center;
    }

    .fruitlist_group_title .heading {
      margin: 0;
    }

    .fruitlist_count {
      color: var(--text-2);
      font-weight: var(--secondary-semibold);
    }

    .fruitlist_now {
      display: none;
    }

    @media (width >= 64rem) {
      .fruitlist_filter {
        flex-direction: row;
        align-items: center;
        gap: var(--space-5);
      }

      .fruitlist_filter_label {
        flex: none;
        width: 8.5rem;
      }

      .fruitlist_group_header {
        grid-template-columns:
          calc(var(--media-disc-small) + var(--space-4) + var(--space-1))
          minmax(0, 1fr) auto 9.375rem
          var(--hit-target-min);
        column-gap: var(--space-4);
      }

      .fruitlist_group_title {
        grid-column: 1 / 3;
      }

      .fruitlist_now {
        grid-column: 3;
        display: grid;
        grid-template-columns: repeat(12, var(--month-cell-width));
        column-gap: var(--space-1);
      }

      .fruitlist_now_tag {
        grid-column: var(--_now, 1);
        justify-self: center;
        padding: var(--space-1) var(--space-3);
        background-color: color-mix(in srgb, var(--brand-500) 22%, transparent);
        border-radius: var(--radius-round);
        color: var(--brand-800);
        font-weight: var(--secondary-bold);
        letter-spacing: var(--letter-spacing-eyebrow);
        text-transform: uppercase;
        white-space: nowrap;
      }
    }

    /* The current month, as a column through each group. It stops short of
       the group line and breaks around whichever fruit is open. */
    .fruitlist_wrap:not([data-now]) .fruitlist_now_tag {
      display: none;
    }

    @media (width >= 64rem) {
      .fruitlist_wrap[data-now] .fruitrow_months::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset-block: 0 calc(var(--border-width-thin) * -1);
        left: calc(
          (var(--_now) - 1) * (var(--month-cell-width) + var(--_cell-gap)) -
            var(--_cell-gap)
        );
        width: calc(var(--month-cell-width) + var(--_cell-gap) * 2);
        background-color: color-mix(in srgb, var(--brand-500) 16%, transparent);
      }

      .fruitlist_wrap .fruitrow_wrap[open] .fruitrow_months::before {
        display: none;
      }

      .fruitlist_wrap .fruitrow_wrap:first-of-type .fruitrow_months::before,
      .fruitlist_wrap
        .fruitrow_wrap[open]
        + .fruitrow_wrap
        .fruitrow_months::before {
        inset-block-start: var(--space-2);
        border-start-start-radius: var(--radius-main);
        border-start-end-radius: var(--radius-main);
      }

      .fruitlist_wrap .fruitrow_wrap:last-of-type .fruitrow_months::before,
      .fruitlist_wrap
        .fruitrow_wrap:has(+ .fruitrow_wrap[open])
        .fruitrow_months::before {
        inset-block-end: var(--space-2);
        border-end-start-radius: var(--radius-main);
        border-end-end-radius: var(--radius-main);
      }
    }
  }
</style>
