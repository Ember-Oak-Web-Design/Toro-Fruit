---
import type { HTMLAttributes } from "astro/types";
import Marquee from "@/components/interactive/Marquee.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Words in the strip. A dot follows each. */
  items: string[];
  /** Color theme of the band. */
  theme?: "light" | "dark" | "brand";
}

const {
  render = true,
  items,
  theme = "dark",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && items.length > 0 && (
    <div
      class:list={["fruitmarquee_band", `theme-${theme}`, className]}
      {...rest}
    >
      <Marquee label="Our fruit" class="fruitmarquee_wrap">
        {items.flatMap((item) => [
          <em class="fruitmarquee_item text-style-h3">{item}</em>,
          <span class="fruitmarquee_dot" aria-hidden="true" />,
        ])}
      </Marquee>
    </div>
  )
}

<style is:global>
  @layer components {
    .fruitmarquee_band {
      padding-block: var(--space-4);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
    }

    .fruitmarquee_wrap {
      --_gap-size: var(--space-5);

      .fruitmarquee_item {
        font-style: italic;
        font-weight: var(--primary-semibold);
        white-space: nowrap;
      }

      .fruitmarquee_dot {
        width: var(--space-3);
        aspect-ratio: 1;
        background-color: var(--brand-500);
        border-radius: var(--radius-round);

        &:nth-of-type(4n + 2) {
          background-color: var(--sun-500);
        }
        &:nth-of-type(4n + 3) {
          background-color: var(--leaf-500);
        }
        &:nth-of-type(4n) {
          background-color: var(--berry-400);
        }
      }
    }
  }
</style>
