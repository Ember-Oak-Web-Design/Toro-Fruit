---
import type { HTMLAttributes, SvgComponent } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Imported SVG shown in the badge. */
  icon: SvgComponent;
  /** Card title. */
  heading: string;
  /** Card text. */
  text: string;
}

const {
  render = true,
  icon,
  heading,
  text,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <div class:list={["pillar_wrap", className]} {...rest}>
      <span class="pillar_badge">
        <Icon src={icon} variant="medium" />
      </span>
      <div class="pillar_content margin-trim">
        <Heading tag="h3" variant="h4">
          {heading}
        </Heading>
        <Paragraph variant="small">{text}</Paragraph>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .pillar_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-6);
      background-color: var(--background-3);
      border-radius: var(--radius-large);
    }

    .pillar_badge {
      display: grid;
      place-items: center;
      width: var(--media-icon-circle);
      aspect-ratio: 1;
      background-color: var(--button-background);
      color: var(--button-text);
      border-radius: var(--radius-round);
    }

    .pillar_content {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);

      .text {
        color: var(--text-2);
      }
    }
  }
</style>
