---
import type { HTMLAttributes } from "astro/types";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Eyebrow text. */
  eyebrow?: string;
  /** Section heading. Wrap words in `<em>` for the italic accent. */
  heading: string;
  /** Heading level. */
  headingTag?: "h1" | "h2" | "h3";
  /** Short text beside the heading. Use the `aside` slot for anything richer. */
  text?: string;
}

const {
  render = true,
  eyebrow,
  heading,
  headingTag = "h2",
  text,
  class: className,
  ...rest
} = Astro.props;

const aside = await slotContent(Astro.slots, "aside");
---

{
  render && (
    <ContentWrapper
      variant="auto-width"
      class:list={["sectionheader_wrap", className]}
      {...rest}
    >
      <Fragment>
        <Eyebrow render={!!eyebrow}>{eyebrow}</Eyebrow>
        <Heading
          tag={headingTag}
          variant="h2"
          maxWidth={18}
          class="sectionheader_title"
        >
          <Fragment set:html={heading} />
        </Heading>
      </Fragment>
      <Fragment slot="column2">
        <Paragraph render={!!text} variant="large" maxWidth={30}>
          {text}
        </Paragraph>
        <Fragment set:html={aside} />
      </Fragment>
    </ContentWrapper>
  )
}

<style is:global>
  @layer components {
    .sectionheader_wrap {
      align-items: flex-end;

      & > :last-child .text {
        color: var(--text-2);
      }
    }
  }
</style>
