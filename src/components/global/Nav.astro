---
import Icon from "@/components/media/Icon.astro";
import Img from "@/components/media/Img.astro";
import Button from "@/components/Button.astro";
import NavLink from "@/components/global/NavLink.astro";
import chevron from "@/assets/icons/arrow.svg";
import logo from "@/assets/logo/toro-fruit.png";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const inProducts = Astro.url.pathname.startsWith("/products");
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Img
            src={logo}
            alt=""
            transparent
            loading="eager"
            variant="constrained"
            sizes="8rem"
          />
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              <li class="nav_item">
                <a
                  class="nav_link"
                  href="/products/"
                  aria-current={inProducts ? "true" : undefined}
                >
                  Products
                  <Icon class="nav_chevron" src={chevron} variant="small" />
                </a>
                <ul class="nav_sub">
                  <NavLink href="/products/fresh-fruit/">Fresh fruit</NavLink>
                  <NavLink href="/products/frozen-fruit/">Frozen fruit</NavLink>
                </ul>
              </li>
              <NavLink href="/food-safety-sustainability/">
                Food Safety &amp; Sustainability
              </NavLink>
              <NavLink href="/about-us/">About Us</NavLink>
              <NavLink href="/contact/">Contact</NavLink>
            </ul>
            <div class="nav_cta">
              <Button element="link" href="/contact/" icon>
                Request a quote
              </Button>
            </div>
          </div>
        </nav>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 64rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-bottom: var(--border-width-thin) solid var(--border);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      flex: none;
      width: 7.75rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: var(--hit-target-min);
      margin-right: calc((var(--hit-target-min) - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width-thin) solid var(--border);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-2);
      font-size: var(--text-main);
      font-weight: var(--secondary-semibold);
      & > li + li {
        border-top: var(--border-width-thin) solid var(--border);
      }
    }

    .nav_link {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      min-height: var(--hit-target-min);
      padding-block: var(--space-3);
      color: var(--text);
      text-decoration: none;
      text-underline-offset: 0.5em;
      text-decoration-color: var(--link-border);
      text-decoration-thickness: var(--border-width);
      transition: opacity var(--hover-duration) var(--hover-ease);
      &[aria-current="page"],
      &[aria-current="true"] {
        text-decoration-line: underline;
      }
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_chevron {
      rotate: 90deg;
    }

    .nav_sub {
      display: flex;
      flex-direction: column;
      padding-left: var(--space-4);
      padding-bottom: var(--space-2);
      font-size: var(--text-small);
    }

    .nav_cta {
      padding: var(--space-3) var(--site-margin) var(--space-5);
    }

    @media (width >= 64rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        flex-grow: 1;
        visibility: visible;
        overflow: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-6);
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        flex-grow: 1;
        padding: 0;
        gap: var(--space-6);
        font-size: var(--text-small);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        padding-block: 0;
        min-height: var(--nav-height);
      }

      .nav_item {
        position: relative;
      }

      .nav_chevron {
        rotate: 90deg;
      }

      .nav_sub {
        position: absolute;
        top: calc(100% - var(--space-3));
        left: calc(var(--space-4) * -1);
        min-width: 14rem;
        padding: var(--space-2);
        gap: var(--space-1);
        background-color: var(--background-3);
        border-radius: var(--radius-main);
        box-shadow: 0 var(--space-4) var(--space-6) calc(var(--space-3) * -1)
          color-mix(in srgb, var(--shadow-500) 30%, transparent);
        opacity: 0;
        visibility: hidden;
        translate: 0 calc(var(--space-1) * -1);
        transition:
          opacity var(--hover-duration) var(--hover-ease),
          translate var(--hover-duration) var(--hover-ease),
          visibility var(--hover-duration) var(--hover-ease);

        .nav_link {
          padding: var(--space-2) var(--space-3);
          min-height: var(--hit-target-min);
          border-radius: var(--radius-small);
          @media (hover: hover) {
            &:hover {
              opacity: 1;
              background-color: var(--background-2);
            }
          }
        }
      }

      .nav_item:is(:hover, :focus-within) > .nav_sub {
        opacity: 1;
        visibility: visible;
        translate: 0 0;
      }

      .nav_cta {
        padding: 0;
        flex: none;
      }
    }
  }
</style>
