---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      <Tag class="eyebrow_text text-style-small">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      color: var(--heading-accent);

      .eyebrow_text {
        font-weight: var(--secondary-bold);
        letter-spacing: var(--letter-spacing-eyebrow);
        text-transform: uppercase;
      }

      &.tag {
        background-color: var(--text);
        color: var(--background);
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-round);
      }
    }
  }
</style>
