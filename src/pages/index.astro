---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import HeroMain from "@/components/content/HeroMain.astro";
import FruitCollage from "@/components/content/FruitCollage.astro";
import FruitMarquee from "@/components/content/FruitMarquee.astro";
import SectionHeader from "@/components/content/SectionHeader.astro";
import ProductCard from "@/components/content/ProductCard.astro";
import RangeCard from "@/components/content/RangeCard.astro";
import Step from "@/components/content/Step.astro";
import PillarCard from "@/components/content/PillarCard.astro";
import LogoTile from "@/components/content/LogoTile.astro";
import RegionItem from "@/components/content/RegionItem.astro";
import SectionCta from "@/components/section/SectionCta.astro";
import shield from "@/assets/icons/shield-check.svg";
import users from "@/assets/icons/users.svg";
import leaf from "@/assets/icons/leaf.svg";
import papayaHalves from "@/assets/photos/papaya-halves.jpg";
import papayaPacked from "@/assets/photos/papaya-packed.jpg";
import { FAMILIES } from "@/data/families.ts";
import { AFFILIATIONS, MARKETS } from "@/data/site.ts";
import { byOrder, fruitImage } from "@/utils/fruit.ts";

const products = (await getCollection("products")).sort(byOrder);

const range = FAMILIES.map((family) => ({
  ...family,
  text: products
    .filter((product) => product.data.family === family.id)
    .map((product) => product.data.name)
    .join(" · "),
}));

const rangeImage: Record<(typeof FAMILIES)[number]["id"], string> = {
  citrus: "oranges",
  stone: "apricots",
  berries: "strawberries",
  exotics: "mangoes",
  melons: "watermelon",
  veg: "butternuts",
};

const marquee = [...FAMILIES.map((family) => family.name), "Frozen berries"];
---

<Layout
  title="South African fresh and frozen fruit exporter"
  description="Toro Fruit exports fresh and frozen South African fruit from GlobalG.A.P.-certified growers to importers across the Middle East, Asia, the EU and the UK."
>
  {/* Hero */}
  <Section
    theme="brand"
    paddingTop="small"
    paddingBottom="small"
    class="background-1"
  >
    <HeroMain
      eyebrow="Fresh & frozen fruit exporter · South Africa"
      eyebrowVariant="tag"
      heading="Sun-grown in South Africa. Shipped to <em>the world.</em>"
      text="Toro Fruit sources citrus, stone fruit, exotics and berries from GlobalG.A.P.-certified growers and delivers them, fresh or frozen, to importers across the Middle East, Asia, the EU and the UK."
      buttons={[
        { label: "Explore our fruit", href: "/products/", icon: true },
        { label: "Request a quote", href: "/contact/", emphasis: "secondary" },
      ]}
      trust={[
        "GlobalG.A.P.-certified growers",
        "SIZA & SEDEX ethical sourcing",
        "Fresh & frozen supply",
      ]}
      trustVariant="strip"
    >
      <FruitCollage
        slot="visual"
        eager
        layers={[
          { type: "circle", color: "light-300", x: 40, y: 40, d: 520 },
          { type: "circle", color: "berry-500", x: 540, y: 520, d: 96 },
          { type: "circle", color: "leaf-500", x: 10, y: 60, d: 64 },
          {
            type: "cutout",
            src: fruitImage("avocado"),
            alt: "Avocados, whole and halved",
            x: 260,
            y: 70,
            w: 340,
            rotate: -8,
          },
          {
            type: "cutout",
            src: fruitImage("oranges"),
            alt: "South African oranges",
            x: 60,
            y: 200,
            w: 520,
          },
          {
            type: "cutout",
            src: fruitImage("mangoes"),
            alt: "Mangoes, whole and halved",
            x: -40,
            y: 470,
            w: 400,
            rotate: 6,
          },
          {
            type: "cutout",
            src: fruitImage("strawberries"),
            alt: "Strawberries",
            x: 360,
            y: 510,
            w: 250,
            rotate: -10,
          },
          {
            type: "badge",
            text: "Fresh &\nfrozen",
            color: "sun-500",
            x: 470,
            y: 0,
            d: 136,
            rotate: 12,
          },
        ]}
      />
    </HeroMain>
  </Section>

  <FruitMarquee items={marquee} />

  {/* What we export */}
  <Section theme="light">
    <SectionHeader
      eyebrow="What we export"
      heading="Fresh from the orchard. <em>Frozen at its peak.</em>"
      text="Whether you stock retail shelves or need bulk supply, every product comes from certified South African growers."
    />
    <Grid medium={2}>
      <ProductCard
        theme="brand"
        surface="2"
        heading="Fresh Fruit"
        text="Citrus, stone fruit, berries, melons, exotics and vegetables."
        buttonLabel="Explore fresh fruit"
        buttonHref="/products/fresh-fruit/"
        layers={[
          {
            type: "cutout",
            src: fruitImage("lemons"),
            alt: "Lemon, whole and split",
            x: 24,
            y: 40,
            anchor: "top-right",
            w: 260,
            rotate: 8,
          },
          {
            type: "cutout",
            src: fruitImage("grapefruit"),
            alt: "Grapefruit, whole, halved and a segment",
            x: -50,
            y: 36,
            anchor: "bottom-right",
            w: 400,
          },
        ]}
      />
      <ProductCard
        theme="dark"
        surface="3"
        heading="Frozen Fruit"
        text="Raspberries, blueberries, mixed berries and strawberries in branded retail packs or 12kg bulk boxes."
        buttonLabel="Explore frozen fruit"
        buttonHref="/products/frozen-fruit/"
        layers={[
          {
            type: "cutout",
            src: fruitImage("strawberries"),
            alt: "Strawberry, whole and halved",
            x: 16,
            y: 34,
            anchor: "top-right",
            w: 240,
            rotate: -8,
          },
          {
            type: "cutout",
            src: fruitImage("frozen-raspberries"),
            alt: "Frozen raspberries",
            x: -24,
            y: 40,
            anchor: "bottom-right",
            w: 340,
          },
        ]}
      />
    </Grid>
  </Section>

  {/* Our range */}
  <Section theme="dark">
    <SectionHeader
      eyebrow="Our fresh range"
      heading="A full basket of South African fruit."
    >
      <Button
        slot="aside"
        variant="link"
        element="link"
        href="/products/fresh-fruit/"
        icon
      >
        See all fresh fruit
      </Button>
    </SectionHeader>
    <Grid small={2} large={3}>
      {
        range.map((family) => (
          <RangeCard
            heading={family.name}
            text={family.text}
            family={family.id}
            image={fruitImage(rangeImage[family.id])}
          />
        ))
      }
    </Grid>
  </Section>

  {/* How we work */}
  <Section theme="light">
    <ContentWrapper variant="columns" reverse>
      <Fragment>
        <Eyebrow>How we work</Eyebrow>
        <Heading tag="h2">From the orchard to <em>your port.</em></Heading>
        <Paragraph variant="main" maxWidth={44}>
          We connect importers with a network of South African growers and take
          care of sourcing, quality and logistics, so your fruit arrives the way
          it left the farm.
        </Paragraph>
        <ol class="width-full margin-top-5">
          <Step
            number="01"
            heading="Certified growers"
            text="Produce comes from GlobalG.A.P.-certified growers who comply with MRL regulations."
            accent="brand-500"
          />
          <Step
            number="02"
            heading="Packed for export"
            text="Fruit is graded, packed and palletised to export standards before it leaves South Africa."
            accent="sun-500"
          />
          <Step
            number="03"
            heading="Shipped to your port"
            text="Consignments travel in refrigerated containers to importers across the Middle East, Asia, the EU and the UK."
            accent="leaf-500"
          />
        </ol>
      </Fragment>
      <FruitCollage
        slot="column2"
        frame={[560, 660]}
        layers={[
          { type: "circle", color: "brand-500", x: 330, y: 20, d: 200 },
          {
            type: "photo",
            src: papayaHalves,
            alt: "Papayas cut open for a quality check",
            x: 0,
            y: 0,
            w: 340,
            h: 453,
          },
          {
            type: "photo",
            src: papayaPacked,
            alt: "Export cartons of papaya, each fruit wrapped in protective netting",
            x: 170,
            y: 340,
            w: 380,
            h: 285,
            border: 8,
          },
          {
            type: "cutout",
            src: fruitImage("lychees"),
            alt: "Lychees",
            x: 320,
            y: 210,
            w: 230,
            rotate: -10,
          },
        ]}
      />
    </ContentWrapper>
  </Section>

  {/* Standards */}
  <Section theme="light" class="background-2">
    <FruitCollage
      slot="background"
      variant="backdrop"
      hideNarrow
      frame={[1440, 964]}
      layers={[
        {
          type: "cutout",
          src: fruitImage("golden-kiwi"),
          x: -90,
          y: -70,
          anchor: "top-right",
          w: 380,
          rotate: 14,
        },
      ]}
    />
    <SectionHeader
      eyebrow="Food safety & sustainability"
      heading="Good fruit starts with <em>good farming.</em>"
    />
    <Grid medium={3}>
      <PillarCard
        icon={shield}
        heading="Food safety"
        text="All our produce comes from GlobalG.A.P.-certified growers who comply with MRL regulations. Selected growers also hold Tesco Nurture, M&S Field to Fork, BRC and HACCP accreditation."
      />
      <PillarCard
        icon={users}
        heading="Social responsibility"
        text="We source from growers who create safe, healthy and happy working environments. Most hold SIZA or SEDEX accreditation and comply with national ethical trading standards."
      />
      <PillarCard
        icon={leaf}
        heading="Environmental responsibility"
        text="Our grower base takes part in programmes covering carbon footprint, water stewardship and biodiversity."
      />
    </Grid>
    <ContentWrapper variant="columns">
      <Eyebrow>Industry affiliations</Eyebrow>
      <Grid xsmall={1} small={2} slot="column2">
        {
          AFFILIATIONS.map((item) => (
            <LogoTile logo={item.logo} alt={item.alt} logoWidth={item.width} />
          ))
        }
      </Grid>
    </ContentWrapper>
  </Section>

  {/* Markets */}
  <Section theme="dark" class="background-3" paddingBottom="large">
    <FruitCollage
      slot="background"
      variant="backdrop"
      hideNarrow
      frame={[1440, 640]}
      layers={[
        {
          type: "cutout",
          src: fruitImage("papaya"),
          x: 50,
          y: -40,
          anchor: "bottom-left",
          w: 460,
          rotate: -7,
        },
      ]}
    />
    <ContentWrapper variant="columns">
      <Fragment>
        <Eyebrow>Where we ship</Eyebrow>
        <Heading tag="h2">From South Africa to <em>your market.</em></Heading>
        <Paragraph variant="main" maxWidth={36}>
          We work with importers, wholesalers and retailers across four key
          regions.
        </Paragraph>
        <ButtonWrapper>
          <Button element="link" href="/contact/" icon
            >Talk to our export team</Button
          >
        </ButtonWrapper>
      </Fragment>
      <Grid slot="column2" xsmall={1} small={2}>
        {
          MARKETS.map((market) => (
            <RegionItem heading={market.name} text={market.detail} />
          ))
        }
      </Grid>
    </ContentWrapper>
  </Section>

  <SectionCta
    theme="brand"
    class="background-2"
    heading="Let’s fill your <em>next container.</em>"
    text="Tell us which fruit you need, the volumes and your destination port, and our team will come back to you with availability and pricing."
    frameHeight={600}
    layers={[
      {
        type: "cutout",
        src: fruitImage("oranges"),
        x: -70,
        y: 290,
        w: 340,
        rotate: -12,
      },
      {
        type: "cutout",
        src: fruitImage("passion-fruit"),
        x: -40,
        y: 56,
        anchor: "top-right",
        w: 300,
        rotate: 12,
      },
      {
        type: "cutout",
        src: fruitImage("avocado"),
        x: 90,
        y: -36,
        anchor: "bottom-right",
        w: 280,
        rotate: -6,
      },
    ]}
  />
</Layout>
